{
    "for": {
        "prefix": "for",
        "body": ["for ${1:i}:=$2;$1<$3;$1+=$4 {$5", "}"],
        "description": "Generic 'for' loop"
    },
    "fori": {
      "prefix": "fori",
      "body": ["for ${1:value} in ${2:iterable} {$3", "}"],
      "description": "For each loop over iterable"
    },
    "println": {
      "prefix": "println",
      "body": ["fmt.println(\"$1\")"],
      "description": "println value"
    }
}
