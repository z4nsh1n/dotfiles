#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
    selected=$1
else
    #selected=$(find ~/code ~/Downloads/ -mindepth 1 -maxdepth 3 -type d | fzf)
    selected=$(fd . ~ ~/code ~/.config ~/Downloads/ ~/Music/ --maxdepth 2 -t d| fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)
has_session=$(zmx l --short | grep $selected_name)

if [[ -z $has_session ]]; then
    cd $selected;zmx r $selected_name -d 
    zmx a $selected_name;
    exit 0
fi

