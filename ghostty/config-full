# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
# font-family = Iosevka
# window-padding-x = 2
#
# # Spacing around the equals sign does not matter.
# # All of these are identical:
# key=value
# key= value
# key =value
# key = value
#
# # Any line beginning with a # is a comment. It's not possible to put
# # a comment after a config option, since it would be interpreted as a
# # part of the value. For example, this will have a value of "#123abc":
# background = #123abc
#
# # Empty values are used to reset config keys to default.
# key =
#
# # Some config options have unique syntaxes for their value,
# # which is explained in the docs for that config option.
# # Just for example:
# resize-overlay-duration = 4s 200ms

# keybind = global:super+backquote=toggle_quick_terminal
font-size = 22
window-inherit-font-size = true
shell-integration = fish
theme = Dracula
window-save-state = always
scrollback-limit = 10000000
mouse-hide-while-typing = true
background-opacity = 0.9

# split-divider-color = #01ff00
unfocused-split-opacity = 0.4 
split-inherit-working-directory = true

# unbind alt+1, etc
keybind = clear
keybind = super+r=reload_config
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
# keybind = ctrl+a>o=text:"clear\n"
# keybind = ctrl+a>s=text:"zmx-session-switcher\n"
#tabs
keybind = ctrl+a>c=new_tab
keybind = ctrl+a>ctrl+l=next_tab
keybind = ctrl+a>ctrl+h=previous_tab
keybind = ctrl+a>w=close_tab
keybind = ctrl+a>r=prompt_tab_title
keybind = ctrl+a>t=toggle_tab_overview
keybind = ctrl+a>]=search_selection

#splits
keybind = ctrl+a>space=toggle_split_zoom
keybind = ctrl+a>v=new_split:right
keybind = ctrl+a>shift+v=new_split:down
keybind = ctrl+a>h=goto_split:left
keybind = ctrl+a>l=goto_split:right
keybind = ctrl+a>j=goto_split:down
keybind = ctrl+a>k=goto_split:up

#search
keybind = ctrl+a>[=start_search
keybind = ctrl+n=navigate_search:previous
keybind = ctrl+shift+n=navigate_search:next
# keybind = ctrl+a>c=new_window
# keybind = ctrl+h=goto_split_left
keybind = ctrl+a>p=write_screen_file:open
keybind = ctrl+shift+u=scroll_page_up
keybind = ctrl+shift+d=scroll_page_down

