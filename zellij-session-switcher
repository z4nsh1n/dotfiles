session=$(zellij list-sessions -n  | grep -v EXITED |  fzf | cut -d ' ' -f 1)

if [[ -z $session ]]; then
  exit 0  
fi

if [[ -z $ZELLIJ ]]; then
  zellij attach "$session"
  exit 0
fi

zellij action switch-session "$session"
